# Lokální vývojový port (frontend na localhostu defaultně volá http://localhost:4000)
PORT=4000

# ── Administrace soutěží (/cs/soutez/admin) ─────────────────────────────────
# Varianta A: Více uživatelů najednou (doporučeno pro více organizátorů)
# Formát: uzivatel1:heslo1,uzivatel2:heslo2   (nebo JSON: {"david":"heslo1","petr":"heslo2"})
CONTEST_ADMIN_USERS=david:Heslo1,petr:Heslo2

# Varianta B: Jeden uživatel (pokud nepoužíváš CONTEST_ADMIN_USERS)
# CONTEST_ADMIN_USERNAME=soutez-admin
# CONTEST_ADMIN_PASSWORD=MojeSilneHeslo123!

# Volitelně heslo pro hlavní /admin panel
# ADMIN_PASSWORD=

# Volitelně Google Cloud Vision API klíč pro OCR na localhostu
# (na Cloud Run se autentizuje automaticky přes GCP Service Account; limit je 950 volání/měsíc, poté fallback na Tesseract.js)
# GOOGLE_CLOUD_VISION_API_KEY=
