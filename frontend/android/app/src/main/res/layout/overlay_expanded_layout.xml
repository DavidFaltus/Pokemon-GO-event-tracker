<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_expanded_root"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_hud_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_pokeball_overlay" />

            <TextView
                android:id="@+id/overlay_hud_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generátor filtrů raidů"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/overlay_close_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="#26FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Search Input with Any Pokemon support -->
    <EditText
        android:id="@+id/overlay_search_input"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="8dp"
        android:background="#2A1E2433"
        android:hint="Hledat jakéhokoliv bose (např. Rayquaza, Lucario)..."
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#94A3B8"
        android:textSize="12sp" />

    <!-- Active Boss Chips Section -->
    <TextView
        android:id="@+id/overlay_chips_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="AKTUÁLNÍ RAID BOSSOVÉ"
        android:textColor="#C084FC"
        android:textSize="10sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/overlay_boss_chips_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Filter Variant Selector (Universal, Budget, Hardcore) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="VARIANTA TÝMU"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_variant_universal"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/overlay_variant_pill_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="⭐ Univerzální"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_variant_budget"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/overlay_variant_pill_default"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="💰 Budget"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_variant_hardcore"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/overlay_variant_pill_default"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔥 Hardcore"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Selected Boss Details Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E171924"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/overlay_selected_boss_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚔️ Kyurem (5★ Raid)"
            android:textColor="#FACC15"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_weaknesses_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="6dp"
            android:text="💥 Slabosti: Fighting, Rock, Steel, Dragon, Fairy"
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/overlay_filter_preview_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2E0A0D14"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:maxLines="3"
            android:padding="6dp"
            android:text="3*,4*&amp;@1fighting,@1rock...&amp;448,639&amp;!@frustration"
            android:textColor="#93C5FD"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Copy Filter Button (Renamed strictly to "Zkopírovat filtr") -->
    <TextView
        android:id="@+id/overlay_copy_filter_btn"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/overlay_copy_button_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Zkopírovat filtr"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_footer_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Klepnutím na tlačítko se filtr zkopíruje a okno se zavře"
        android:textColor="#94A3B8"
        android:textSize="10sp" />

</LinearLayout>
